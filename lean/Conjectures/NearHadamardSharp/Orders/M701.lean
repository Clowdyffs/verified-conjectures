namespace Q701
local instance : Fact (Nat.Prime 701) := ⟨by decide⟩
abbrev F0 := ZMod 701
def w : F0 := 2
theorem hc : Fintype.card F0=701 := by simp [F0,Small.card_model]
theorem hw : IsPrimitiveRoot w (701-1) := by
  apply Small.primitiveCheck [2, 2, 5, 5, 7] <;> decide +kernel
local instance : Fact (∀ x : F0, x^2≠w+0*x) :=
  ⟨Torus.irreducible (Border.char_generator (hc.symm ▸ (by decide : 701%4=1)) (hc.symm ▸ hw))⟩
def z : Torus.Model w := ⟨2,1⟩
def zi : Torus.Model w := ⟨1,350⟩
theorem hz : IsPrimitiveRoot z (701*701-1) := by
  apply Small.primitiveCheck [2, 2, 2, 3, 3, 3, 5, 5, 7, 13] <;> decide +kernel
theorem invz : z⁻¹=zi := inv_eq_of_mul_eq_one_right (by decide +kernel : z*zi=1)
theorem verified : AtOrder 701 := by
  apply modelOrder w z hc (by decide) hw hz
  · apply torusGood z hc (by decide) hw hz (by decide); decide +kernel
  · rw [invz]; apply torusGood zi hc (by decide) hw (invz ▸ hz.inv) (by decide); decide +kernel
  · apply borderGood hc (by decide) hw (by decide) true; decide +kernel
  · apply borderGood hc (by decide) hw (by decide) false; decide +kernel
end Q701

