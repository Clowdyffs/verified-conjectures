namespace Q37
local instance : Fact (Nat.Prime 37) := ⟨by decide⟩
abbrev F0 := ZMod 37
def w : F0 := 2
theorem hc : Fintype.card F0=37 := by simp [F0,Small.card_model]
theorem hw : IsPrimitiveRoot w (37-1) := by
  apply Small.primitiveCheck [2, 2, 3, 3] <;> decide +kernel
local instance : Fact (∀ x : F0, x^2≠w+0*x) :=
  ⟨Torus.irreducible (Border.char_generator (hc.symm ▸ (by decide : 37%4=1)) (hc.symm ▸ hw))⟩
def z : Torus.Model w := ⟨2,1⟩
def zi : Torus.Model w := ⟨1,18⟩
theorem hz : IsPrimitiveRoot z (37*37-1) := by
  apply Small.primitiveCheck [2, 2, 2, 3, 3, 19] <;> decide +kernel
theorem invz : z⁻¹=zi := inv_eq_of_mul_eq_one_right (by decide +kernel : z*zi=1)
