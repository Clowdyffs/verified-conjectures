theorem five_det : |(Source.bordered 37 w true).det| = 622378592902414294409281536000 := by
  apply borderExactRow hc (by decide) hw true fiveRow _ (by decide) (by decide +kernel)
  apply arrayCert (borderedMatrix (m:=18) 37 true fiveRow) fiveL fiveD <;> decide +kernel
theorem verified : AtOrder 37 := by
  apply modelOrder w z hc (by decide) hw hz
  · rw [torus_det]; decide +kernel
  · rw [invz]; apply torusGood zi hc (by decide) hw (invz ▸ hz.inv) (by decide); decide +kernel
  · rw [five_det]; decide +kernel
  · apply borderGood hc (by decide) hw (by decide) false; decide +kernel
theorem attained : restrictedMinimum .five ∈ values 30 .five := by
  apply modelValue w z hc (by decide) (by decide) hw hz
  simp only [magnitude]
  rw [five_det]; decide +kernel
